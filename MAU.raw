local humanoid = script.Parent:WaitForChild("Humanoid")

humanoid.FreeFalling:Connect(function(fällt)
    if fällt then
        local function sound(id)
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://" .. id
            s.Parent = humanoid.Parent:WaitForChild("Head")
            s:Play()
            return s
        end

        local schrei = sound("SCHREI_ID")
        schrei.Ended:Wait()

        local lachen = sound("LACH_ID")
        lachen:Play()
    end
end)
