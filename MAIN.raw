window.setFLOW = ({ h, b, t, q, d, f } = {}) => {
  if (h !== undefined) H = h;
  if (b !== undefined) B = b;
  if (t !== undefined) T = t;
  if (q !== undefined) Q = q;
  if (d !== undefined) D = d;
  if (f !== undefined) F = f;

  const flow = { H, B, T, Q, D, F };

  return {
    MAIN: flow,
    move: MAIN.raw.FLOW,
    axis: Achse.756
  };
};
